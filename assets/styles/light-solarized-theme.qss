/* Light Solarized Theme for Pencil */

QMainWindow {
    background-color: #fdf6e3;
}

QMenuBar {
    background-color: #fdf6e3;
    color: #657b83;
    border-bottom: 1px solid #d3d0c8;
    padding: 2px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background-color: #eee8d5;
    color: #657b83;
}

QMenuBar::item:pressed {
    background-color: #268bd2;
    color: #fdf6e3;
}

QToolBar {
    background-color: #fdf6e3;
    border-bottom: 1px solid #d3d0c8;
    spacing: 4px;
    padding: 4px;
}

QToolBar::separator {
    background-color: #d3d0c8;
    width: 1px;
    height: 20px;
    margin: 4px 4px;
}

QToolBar::handle {
    background-color: transparent;
}

QToolBar QToolButton {
    background-color: transparent;
    border: none;
    color: #657b83;
    padding: 4px 8px;
    border-radius: 3px;
    min-width: 24px;
}

QToolBar QToolButton:hover {
    background-color: #eee8d5;
    color: #657b83;
}

QToolBar QToolButton:pressed {
    background-color: #268bd2;
    color: #fdf6e3;
}

QToolBar QToolButton:checked {
    background-color: #268bd2;
    color: #fdf6e3;
}

QMenu {
    background-color: #fdf6e3;
    color: #657b83;
    border: 1px solid #d3d0c8;
    padding: 4px;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 24px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #268bd2;
    color: #fdf6e3;
}

QMenu::item:disabled {
    color: #808080;
}

QMenu::separator {
    background-color: #d3d0c8;
    height: 1px;
    margin: 4px 8px;
}

QStatusBar {
    background-color: #268bd2;
    color: #ffffff;
    border-top: none;
    padding: 4px;
}

QStatusBar::item {
    border: none;
}

/* ---- Buttons: modern glass ---- */
QPushButton,
QDialogButtonBox QPushButton,
QDialog QPushButton,
QFileDialog QPushButton,
QMessageBox QPushButton {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #88bfe6,
        stop: 0.55 #52a2db,
        stop: 1 #7bb8e4
    );
    color: #16181d;
    border: 1px solid #1b6193;
    border-top: 1px solid #92c5e8;
    border-radius: 10px;
    padding: 7px 22px;
    min-width: 88px;
    font-size: 10pt;
    font-weight: 600;
}

QPushButton:hover {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #88bfe6,
        stop: 0.55 #88bfe7,
        stop: 1 #93c5e9
    );
    border: 1px solid #92c5e8;
}

QPushButton:pressed {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #76b1db,
        stop: 0.55 #6fa6cd,
        stop: 1 #6fa6cd
    );
    border: 1px solid #17537e;
    padding-top: 8px;
    padding-bottom: 6px;
}

QPushButton:focus {
    border: 1px solid #bedcf2;
}

QPushButton:disabled {
    background-color: #dbe5e0;
    color: #a19d94;
    border: 1px solid #dbe5e0;
}

QPushButton::menu-indicator {
    width: 9px;
    height: 9px;
    subcontrol-position: center right;
    right: 10px;
}

QFileDialog {
    background-color: #fdf6e3;
    color: #657b83;
}

QFileDialog QListView {
    background-color: #fdf6e3;
    color: #657b83;
    border: 1px solid #d3d0c8;
}

QFileDialog QTreeView {
    background-color: #fdf6e3;
    color: #657b83;
    border: 1px solid #d3d0c8;
}

QFileDialog QLineEdit {
    background-color: #fdf6e3;
    color: #657b83;
    border: 1px solid #d3d0c8;
    padding: 4px;
    border-radius: 2px;
}

QMessageBox {
    background-color: #fdf6e3;
}

QMessageBox QLabel {
    color: #657b83;
}

/* ---- Editor + gutter ---- */
QTextEdit#textEdit {
    background-color: #eee8d5;
    color: #657b83;
    selection-background-color: #268bd2;
    selection-color: #fdf6e3;
    border: 1px solid #fdf6e3;
    border-radius: 8px;
}

QTextEdit#textEdit:focus {
    border: 1px solid #fdf6e3;
}

QTextEdit#numberLine {
    background-color: #e3dcc8;
    color: #728087;
    selection-background-color: transparent;
    border: 1px solid transparent;
    border-right: 1px solid #fdf6e3;
    border-radius: 8px;
}

QTextEdit#numberLine:focus {
    border: 1px solid transparent;
    border-right: 1px solid #fdf6e3;
}

QTextEdit#numberLine:disabled {
    background-color: #e3dcc8;
    color: #728087;
    selection-background-color: transparent;
}
QScrollBar:vertical {
    background-color: #fdf6e3;
    width: 16px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #d3d0c8;
    min-height: 20px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #268bd2;
}

QScrollBar::handle:vertical:pressed {
    background-color: #268bd2;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #fdf6e3;
    height: 16px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #d3d0c8;
    min-width: 20px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #268bd2;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #268bd2;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}
