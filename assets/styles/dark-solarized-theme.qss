/* Dark Solarized Theme for Pencil */

QMainWindow {
    background-color: #002b36;
}

QMenuBar {
    background-color: #002b36;
    color: #839496;
    border-bottom: 1px solid #073642;
    padding: 2px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background-color: #073642;
    color: #839496;
}

QMenuBar::item:pressed {
    background-color: #268bd2;
    color: #002b36;
}

QToolBar {
    background-color: #002b36;
    border-bottom: 1px solid #073642;
    spacing: 4px;
    padding: 4px;
}

QToolBar::separator {
    background-color: #073642;
    width: 1px;
    height: 20px;
    margin: 4px 4px;
}

QToolBar::handle {
    background-color: transparent;
}

QToolBar QToolButton {
    background-color: transparent;
    border: none;
    color: #839496;
    padding: 4px 8px;
    border-radius: 3px;
    min-width: 24px;
}

QToolBar QToolButton:hover {
    background-color: #073642;
    color: #839496;
}

QToolBar QToolButton:pressed {
    background-color: #268bd2;
    color: #002b36;
}

QToolBar QToolButton:checked {
    background-color: #268bd2;
    color: #002b36;
}

QMenu {
    background-color: #002b36;
    color: #839496;
    border: 1px solid #073642;
    padding: 4px;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 24px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #268bd2;
    color: #002b36;
}

QMenu::item:disabled {
    color: #808080;
}

QMenu::separator {
    background-color: #073642;
    height: 1px;
    margin: 4px 8px;
}

QStatusBar {
    background-color: #586e75;
    color: #ffffff;
    border-top: none;
    padding: 4px;
}

QStatusBar::item {
    border: none;
}

QFileDialog {
    background-color: #002b36;
    color: #839496;
}

QFileDialog QListView {
    background-color: #002b36;
    color: #839496;
    border: 1px solid #073642;
}

QFileDialog QTreeView {
    background-color: #002b36;
    color: #839496;
    border: 1px solid #073642;
}

QFileDialog QLineEdit {
    background-color: #073642;
    color: #839496;
    border: 1px solid #586e75;
    padding: 4px;
    border-radius: 2px;
}

QMessageBox {
    background-color: #002b36;
}

QMessageBox QLabel {
    color: #839496;
}

/* ---- Editor + gutter ---- */
QTextEdit#textEdit {
    background-color: #073642;
    color: #93a1a1;
    selection-background-color: #586e75;
    selection-color: #fdf6e3;
    border: 1px solid #002b36;
    border-radius: 8px;
}

QTextEdit#textEdit:focus {
    border: 1px solid #002b36;
}

QTextEdit#numberLine {
    background-color: #013a46;
    color: #7d9699;
    selection-background-color: transparent;
    border: 1px solid transparent;
    border-right: 1px solid #002b36;
    border-radius: 8px;
}

QTextEdit#numberLine:focus {
    border: 1px solid transparent;
    border-right: 1px solid #002b36;
}

QTextEdit#numberLine:disabled {
    background-color: #013a46;
    color: #71898b;
    selection-background-color: transparent;
}
QScrollBar:vertical {
    background-color: #002b36;
    width: 16px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #586e75;
    min-height: 20px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #268bd2;
}

QScrollBar::handle:vertical:pressed {
    background-color: #268bd2;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #002b36;
    height: 16px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #586e75;
    min-width: 20px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #268bd2;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #268bd2;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}
