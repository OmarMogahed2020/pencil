/* Dark Dracula Theme for Pencil */

QMainWindow {
    background-color: #282a36;
}

QMenuBar {
    background-color: #282a36;
    color: #f8f8f2;
    border-bottom: 1px solid #44475a;
    padding: 2px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background-color: #44475a;
    color: #f8f8f2;
}

QMenuBar::item:pressed {
    background-color: #bd93f9;
    color: #282a36;
}

QToolBar {
    background-color: #282a36;
    border-bottom: 1px solid #44475a;
    spacing: 4px;
    padding: 4px;
}

QToolBar::separator {
    background-color: #44475a;
    width: 1px;
    height: 20px;
    margin: 4px 4px;
}

QToolBar::handle {
    background-color: transparent;
}

QToolBar QToolButton {
    background-color: transparent;
    border: none;
    color: #f8f8f2;
    padding: 4px 8px;
    border-radius: 3px;
    min-width: 24px;
}

QToolBar QToolButton:hover {
    background-color: #44475a;
    color: #f8f8f2;
}

QToolBar QToolButton:pressed {
    background-color: #bd93f9;
    color: #282a36;
}

QToolBar QToolButton:checked {
    background-color: #bd93f9;
    color: #282a36;
}

QMenu {
    background-color: #282a36;
    color: #f8f8f2;
    border: 1px solid #44475a;
    padding: 4px;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 24px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #bd93f9;
    color: #282a36;
}

QMenu::item:disabled {
    color: #808080;
}

QMenu::separator {
    background-color: #44475a;
    height: 1px;
    margin: 4px 8px;
}

QStatusBar {
    background-color: #6272a4;
    color: #ffffff;
    border-top: none;
    padding: 4px;
}

QStatusBar::item {
    border: none;
}

/* ---- Buttons: modern glass ---- */
QPushButton,
QDialogButtonBox QPushButton,
QDialog QPushButton,
QFileDialog QPushButton,
QMessageBox QPushButton {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #dbc4fc,
        stop: 0.55 #caa9fa,
        stop: 1 #d7bdfb
    );
    color: #16181d;
    border: 1px solid #d1b3fb;
    border-top: 1px solid #dec9fc;
    border-radius: 10px;
    padding: 7px 22px;
    min-width: 88px;
    font-size: 10pt;
    font-weight: 600;
}

QPushButton:hover {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #dbc4fc,
        stop: 0.55 #dbc4fb,
        stop: 1 #dec9fc
    );
    border: 1px solid #dec9fc;
}

QPushButton:pressed {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #ceb5f1,
        stop: 0.55 #c2aae2,
        stop: 1 #c2aae2
    );
    border: 1px solid #715895;
    padding-top: 8px;
    padding-bottom: 6px;
}

QPushButton:focus {
    border: 1px solid #ebdffd;
}

QPushButton:disabled {
    background-color: #403b55;
    color: #21232c;
    border: 1px solid #403b55;
}

QPushButton::menu-indicator {
    width: 9px;
    height: 9px;
    subcontrol-position: center right;
    right: 10px;
}

QFileDialog {
    background-color: #282a36;
    color: #f8f8f2;
}

QFileDialog QListView {
    background-color: #282a36;
    color: #f8f8f2;
    border: 1px solid #44475a;
}

QFileDialog QTreeView {
    background-color: #282a36;
    color: #f8f8f2;
    border: 1px solid #44475a;
}

QFileDialog QLineEdit {
    background-color: #44475a;
    color: #f8f8f2;
    border: 1px solid #6272a4;
    padding: 4px;
    border-radius: 2px;
}

QMessageBox {
    background-color: #282a36;
}

QMessageBox QLabel {
    color: #f8f8f2;
}

/* ---- Editor + gutter ---- */
QTextEdit#textEdit {
    background-color: #21222c;
    color: #f8f8f2;
    selection-background-color: #44475a;
    selection-color: #f8f8f2;
    border: 1px solid #282a36;
    border-radius: 8px;
}

QTextEdit#textEdit:focus {
    border: 1px solid #282a36;
}

QTextEdit#numberLine {
    background-color: #191a21;
    color: #8b8fa3;
    selection-background-color: transparent;
    border: 1px solid transparent;
    border-right: 1px solid #282a36;
    border-radius: 8px;
}

QTextEdit#numberLine:focus {
    border: 1px solid transparent;
    border-right: 1px solid #282a36;
}

QTextEdit#numberLine:disabled {
    background-color: #191a21;
    color: #7b7f92;
    selection-background-color: transparent;
}
QScrollBar:vertical {
    background-color: #282a36;
    width: 16px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #6272a4;
    min-height: 20px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #bd93f9;
}

QScrollBar::handle:vertical:pressed {
    background-color: #bd93f9;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #282a36;
    height: 16px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #6272a4;
    min-width: 20px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #bd93f9;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #bd93f9;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}
