/* Dark Github Theme for Pencil */

QMainWindow {
    background-color: #0d1117;
}

QMenuBar {
    background-color: #0d1117;
    color: #c9d1d9;
    border-bottom: 1px solid #30363d;
    padding: 2px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background-color: #161b22;
    color: #c9d1d9;
}

QMenuBar::item:pressed {
    background-color: #58a6ff;
    color: #0d1117;
}

QToolBar {
    background-color: #0d1117;
    border-bottom: 1px solid #30363d;
    spacing: 4px;
    padding: 4px;
}

QToolBar::separator {
    background-color: #30363d;
    width: 1px;
    height: 20px;
    margin: 4px 4px;
}

QToolBar::handle {
    background-color: transparent;
}

QToolBar QToolButton {
    background-color: transparent;
    border: none;
    color: #c9d1d9;
    padding: 4px 8px;
    border-radius: 3px;
    min-width: 24px;
}

QToolBar QToolButton:hover {
    background-color: #161b22;
    color: #c9d1d9;
}

QToolBar QToolButton:pressed {
    background-color: #58a6ff;
    color: #0d1117;
}

QToolBar QToolButton:checked {
    background-color: #58a6ff;
    color: #0d1117;
}

QMenu {
    background-color: #161b22;
    color: #c9d1d9;
    border: 1px solid #30363d;
    padding: 4px;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 24px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #58a6ff;
    color: #0d1117;
}

QMenu::item:disabled {
    color: #808080;
}

QMenu::separator {
    background-color: #30363d;
    height: 1px;
    margin: 4px 8px;
}

QStatusBar {
    background-color: #1f6feb;
    color: #ffffff;
    border-top: none;
    padding: 4px;
}

QStatusBar::item {
    border: none;
}

/* ---- Buttons: modern glass ---- */
QPushButton,
QDialogButtonBox QPushButton,
QDialog QPushButton,
QFileDialog QPushButton,
QMessageBox QPushButton {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #a3ceff,
        stop: 0.55 #7ab8ff,
        stop: 1 #99c9ff
    );
    color: #16181d;
    border: 1px solid #8ac1ff;
    border-top: 1px solid #acd2ff;
    border-radius: 10px;
    padding: 7px 22px;
    min-width: 88px;
    font-size: 10pt;
    font-weight: 600;
}

QPushButton:hover {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #a3ceff,
        stop: 0.55 #a3ceff,
        stop: 1 #abd3ff
    );
    border: 1px solid #acd2ff;
}

QPushButton:pressed {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #93c1f5,
        stop: 0.55 #8ab5e6,
        stop: 1 #8ab5e6
    );
    border: 1px solid #356499;
    padding-top: 8px;
    padding-bottom: 6px;
}

QPushButton:focus {
    border: 1px solid #cde4ff;
}

QPushButton:disabled {
    background-color: #19293c;
    color: #111419;
    border: 1px solid #19293c;
}

QPushButton::menu-indicator {
    width: 9px;
    height: 9px;
    subcontrol-position: center right;
    right: 10px;
}

QFileDialog {
    background-color: #0d1117;
    color: #c9d1d9;
}

QFileDialog QListView {
    background-color: #0d1117;
    color: #c9d1d9;
    border: 1px solid #30363d;
}

QFileDialog QTreeView {
    background-color: #0d1117;
    color: #c9d1d9;
    border: 1px solid #30363d;
}

QFileDialog QLineEdit {
    background-color: #0d1117;
    color: #c9d1d9;
    border: 1px solid #30363d;
    padding: 4px;
    border-radius: 2px;
}

QMessageBox {
    background-color: #0d1117;
}

QMessageBox QLabel {
    color: #c9d1d9;
}

/* ---- Editor + gutter ---- */
QTextEdit#textEdit {
    background-color: #161b22;
    color: #c9d1d9;
    selection-background-color: #1f6feb;
    selection-color: #ffffff;
    border: 1px solid #30363d;
    border-radius: 8px;
}

QTextEdit#textEdit:focus {
    border: 1px solid #30363d;
}

QTextEdit#numberLine {
    background-color: #0b0f14;
    color: #8b949e;
    selection-background-color: transparent;
    border: 1px solid transparent;
    border-right: 1px solid #30363d;
    border-radius: 8px;
}

QTextEdit#numberLine:focus {
    border: 1px solid transparent;
    border-right: 1px solid #30363d;
}

QTextEdit#numberLine:disabled {
    background-color: #0b0f14;
    color: #7d8797;
    selection-background-color: transparent;
}
QScrollBar:vertical {
    background-color: #0d1117;
    width: 16px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #30363d;
    min-height: 20px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #58a6ff;
}

QScrollBar::handle:vertical:pressed {
    background-color: #58a6ff;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #0d1117;
    height: 16px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #30363d;
    min-width: 20px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #58a6ff;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #58a6ff;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}
