/* Light Nord Theme for Pencil */

QMainWindow {
    background-color: #eceff4;
}

QMenuBar {
    background-color: #eceff4;
    color: #2e3440;
    border-bottom: 1px solid #d8dee9;
    padding: 2px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background-color: #d8dee9;
    color: #2e3440;
}

QMenuBar::item:pressed {
    background-color: #88c0d0;
    color: #eceff4;
}

QToolBar {
    background-color: #eceff4;
    border-bottom: 1px solid #d8dee9;
    spacing: 4px;
    padding: 4px;
}

QToolBar::separator {
    background-color: #d8dee9;
    width: 1px;
    height: 20px;
    margin: 4px 4px;
}

QToolBar::handle {
    background-color: transparent;
}

QToolBar QToolButton {
    background-color: transparent;
    border: none;
    color: #2e3440;
    padding: 4px 8px;
    border-radius: 3px;
    min-width: 24px;
}

QToolBar QToolButton:hover {
    background-color: #d8dee9;
    color: #2e3440;
}

QToolBar QToolButton:pressed {
    background-color: #88c0d0;
    color: #eceff4;
}

QToolBar QToolButton:checked {
    background-color: #88c0d0;
    color: #eceff4;
}

QMenu {
    background-color: #eceff4;
    color: #2e3440;
    border: 1px solid #d8dee9;
    padding: 4px;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 24px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #88c0d0;
    color: #eceff4;
}

QMenu::item:disabled {
    color: #808080;
}

QMenu::separator {
    background-color: #d8dee9;
    height: 1px;
    margin: 4px 8px;
}

QStatusBar {
    background-color: #5e81ac;
    color: #ffffff;
    border-top: none;
    padding: 4px;
}

QStatusBar::item {
    border: none;
}

/* ---- Buttons: modern glass ---- */
QPushButton,
QDialogButtonBox QPushButton,
QDialog QPushButton,
QFileDialog QPushButton,
QMessageBox QPushButton {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #bedce5,
        stop: 0.55 #a0cdda,
        stop: 1 #b6d9e2
    );
    color: #16181d;
    border: 1px solid #5f8692;
    border-top: 1px solid #c4e0e8;
    border-radius: 10px;
    padding: 7px 22px;
    min-width: 88px;
    font-size: 10pt;
    font-weight: 600;
}

QPushButton:hover {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #bedce5,
        stop: 0.55 #bddde5,
        stop: 1 #c3e0e7
    );
    border: 1px solid #c4e0e8;
}

QPushButton:pressed {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #afd0d9,
        stop: 0.55 #a4c3cb,
        stop: 1 #a4c3cb
    );
    border: 1px solid #52737d;
    padding-top: 8px;
    padding-bottom: 6px;
}

QPushButton:focus {
    border: 1px solid #dbecf1;
}

QPushButton:disabled {
    background-color: #dce7ee;
    color: #96999e;
    border: 1px solid #dce7ee;
}

QPushButton::menu-indicator {
    width: 9px;
    height: 9px;
    subcontrol-position: center right;
    right: 10px;
}

QFileDialog {
    background-color: #eceff4;
    color: #2e3440;
}

QFileDialog QListView {
    background-color: #eceff4;
    color: #2e3440;
    border: 1px solid #d8dee9;
}

QFileDialog QTreeView {
    background-color: #eceff4;
    color: #2e3440;
    border: 1px solid #d8dee9;
}

QFileDialog QLineEdit {
    background-color: #ffffff;
    color: #2e3440;
    border: 1px solid #d8dee9;
    padding: 4px;
    border-radius: 2px;
}

QMessageBox {
    background-color: #eceff4;
}

QMessageBox QLabel {
    color: #2e3440;
}

/* ---- Editor + gutter ---- */
QTextEdit#textEdit {
    background-color: #ffffff;
    color: #2e3440;
    selection-background-color: #88c0d0;
    selection-color: #2e3440;
    border: 1px solid #eceff4;
    border-radius: 8px;
}

QTextEdit#textEdit:focus {
    border: 1px solid #eceff4;
}

QTextEdit#numberLine {
    background-color: #d8dee9;
    color: #5e6b7d;
    selection-background-color: transparent;
    border: 1px solid transparent;
    border-right: 1px solid #eceff4;
    border-radius: 8px;
}

QTextEdit#numberLine:focus {
    border: 1px solid transparent;
    border-right: 1px solid #eceff4;
}

QTextEdit#numberLine:disabled {
    background-color: #d8dee9;
    color: #5e6b7d;
    selection-background-color: transparent;
}
QScrollBar:vertical {
    background-color: #eceff4;
    width: 16px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #d8dee9;
    min-height: 20px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #88c0d0;
}

QScrollBar::handle:vertical:pressed {
    background-color: #88c0d0;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #eceff4;
    height: 16px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #d8dee9;
    min-width: 20px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #88c0d0;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #88c0d0;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}
