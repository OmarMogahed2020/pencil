/* VS Code Dark Theme for Pencil */

QMainWindow {
    background-color: #1e1e1e;
}

QMenuBar {
    background-color: #1e1e1e;
    color: #cccccc;
    border-bottom: 1px solid #333333;
    padding: 2px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background-color: #2d2d2d;
    color: #ffffff;
}

QMenuBar::item:pressed {
    background-color: #094771;
    color: #ffffff;
}

QToolBar {
    background-color: #1e1e1e;
    border-bottom: 1px solid #333333;
    spacing: 4px;
    padding: 4px;
}

QToolBar::separator {
    background-color: #333333;
    width: 1px;
    height: 20px;
    margin: 4px 4px;
}

QToolBar::handle {
    background-color: transparent;
}

QToolBar QToolButton {
    background-color: transparent;
    border: none;
    color: #cccccc;
    padding: 4px 8px;
    border-radius: 3px;
    min-width: 24px;
}

QToolBar QToolButton:hover {
    background-color: #2d2d2d;
    color: #ffffff;
}

QToolBar QToolButton:pressed {
    background-color: #094771;
    color: #ffffff;
}

QToolBar QToolButton:checked {
    background-color: #094771;
    color: #ffffff;
}

QMenu {
    background-color: #252526;
    color: #cccccc;
    border: 1px solid #333333;
    padding: 4px;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 24px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #094771;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #5a5a5a;
}

QMenu::separator {
    background-color: #333333;
    height: 1px;
    margin: 4px 8px;
}

QStatusBar {
    background-color: #68217A;
    color: #ffffff;
    border-top: none;
    padding: 4px;
}

QStatusBar::item {
    border: none;
}

/* ---- Buttons: modern glass ---- */
QPushButton,
QDialogButtonBox QPushButton,
QDialog QPushButton,
QFileDialog QPushButton,
QMessageBox QPushButton {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #357cac,
        stop: 0.55 #1f6ea3,
        stop: 1 #0e639c
    );
    color: #ffffff;
    border: 1px solid #5692ba;
    border-top: 1px solid #86b1ce;
    border-radius: 10px;
    padding: 7px 22px;
    min-width: 88px;
    font-size: 10pt;
    font-weight: 600;
}

QPushButton:hover {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #357cac,
        stop: 0.55 #2371a5,
        stop: 1 #357cac
    );
    border: 1px solid #86b1ce;
}

QPushButton:pressed {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #0c5789,
        stop: 0.55 #0a4770,
        stop: 1 #0a4770
    );
    border: 1px solid #083b5e;
    padding-top: 8px;
    padding-bottom: 6px;
}

QPushButton:focus {
    border: 1px solid #b7d0e1;
}

QPushButton:disabled {
    background-color: #1b2932;
    color: #787878;
    border: 1px solid #1b2932;
}

QPushButton::menu-indicator {
    width: 9px;
    height: 9px;
    subcontrol-position: center right;
    right: 10px;
}

QFileDialog {
    background-color: #1e1e1e;
    color: #cccccc;
}

QFileDialog QListView {
    background-color: #252526;
    color: #cccccc;
    border: 1px solid #333333;
}

QFileDialog QTreeView {
    background-color: #252526;
    color: #cccccc;
    border: 1px solid #333333;
}

QFileDialog QLineEdit {
    background-color: #3c3c3c;
    color: #cccccc;
    border: 1px solid #3c3c3c;
    padding: 4px;
    border-radius: 2px;
}

QMessageBox {
    background-color: #1e1e1e;
}

QMessageBox QLabel {
    color: #cccccc;
}

/* ---- Editor + gutter ---- */
QTextEdit#textEdit {
    background-color: #252526;
    color: #d4d4d4;
    selection-background-color: #094771;
    selection-color: #ffffff;
    border: 1px solid #333333;
    border-radius: 8px;
}

QTextEdit#textEdit:focus {
    border: 1px solid #333333;
}

QTextEdit#numberLine {
    background-color: #1b1b1b;
    color: #858585;
    selection-background-color: transparent;
    border: 1px solid transparent;
    border-right: 1px solid #333333;
    border-radius: 8px;
}

QTextEdit#numberLine:focus {
    border: 1px solid transparent;
    border-right: 1px solid #333333;
}

QTextEdit#numberLine:disabled {
    background-color: #1b1b1b;
    color: #707070;
    selection-background-color: transparent;
}
QScrollBar:vertical {
    background-color: #1e1e1e;
    width: 16px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #424242;
    min-height: 20px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4f4f4f;
}

QScrollBar::handle:vertical:pressed {
    background-color: #5a5a5a;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #1e1e1e;
    height: 16px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #424242;
    min-width: 20px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #4f4f4f;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #5a5a5a;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}
