/* Light Theme for Pencil */

QMainWindow {
    background-color: #ffffff;
}

QMenuBar {
    background-color: #ffffff;
    color: #333333;
    border-bottom: 1px solid #e0e0e0;
    padding: 2px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background-color: #e8e8e8;
    color: #000000;
}

QMenuBar::item:pressed {
    background-color: #68217A;
    color: #ffffff;
}

QToolBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e0e0e0;
    spacing: 4px;
    padding: 4px;
}

QToolBar::separator {
    background-color: #e0e0e0;
    width: 1px;
    height: 20px;
    margin: 4px 4px;
}

QToolBar::handle {
    background-color: transparent;
}

QToolBar QToolButton {
    background-color: transparent;
    border: none;
    color: #333333;
    padding: 4px 8px;
    border-radius: 3px;
    min-width: 24px;
}

QToolBar QToolButton:hover {
    background-color: #e8e8e8;
    color: #000000;
}

QToolBar QToolButton:pressed {
    background-color: #68217A;
    color: #ffffff;
}

QToolBar QToolButton:checked {
    background-color: #68217A;
    color: #ffffff;
}

QMenu {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #e0e0e0;
    padding: 4px;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 24px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #68217A;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #aaaaaa;
}

QMenu::separator {
    background-color: #e0e0e0;
    height: 1px;
    margin: 4px 8px;
}

QStatusBar {
    background-color: #68217A;
    color: #ffffff;
    border-top: none;
    padding: 4px;
}

QStatusBar::item {
    border: none;
}

/* ---- Buttons: modern glass ---- */
QPushButton,
QDialogButtonBox QPushButton,
QDialog QPushButton,
QFileDialog QPushButton,
QMessageBox QPushButton {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #9564a2,
        stop: 0.55 #7c3f8c,
        stop: 1 #68217A
    );
    color: #ffffff;
    border: 1px solid #491755;
    border-top: 1px solid #b490bc;
    border-radius: 10px;
    padding: 7px 22px;
    min-width: 88px;
    font-size: 10pt;
    font-weight: 600;
}

QPushButton:hover {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #9564a2,
        stop: 0.55 #773787,
        stop: 1 #834992
    );
    border: 1px solid #b490bc;
}

QPushButton:pressed {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #5c1d6b,
        stop: 0.55 #4b1858,
        stop: 1 #4b1858
    );
    border: 1px solid #3e1449;
    padding-top: 8px;
    padding-bottom: 6px;
}

QPushButton:focus {
    border: 1px solid #d2bcd7;
}

QPushButton:disabled {
    background-color: #e7dbea;
    color: #ffffff;
    border: 1px solid #e7dbea;
}

QPushButton::menu-indicator {
    width: 9px;
    height: 9px;
    subcontrol-position: center right;
    right: 10px;
}

QFileDialog {
    background-color: #ffffff;
    color: #333333;
}

QFileDialog QListView {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #e0e0e0;
}

QFileDialog QTreeView {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #e0e0e0;
}

QFileDialog QLineEdit {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #c0c0c0;
    padding: 4px;
    border-radius: 2px;
}

QMessageBox {
    background-color: #ffffff;
}

QMessageBox QLabel {
    color: #333333;
}

/* ---- Editor + gutter ---- */
QTextEdit#textEdit {
    background-color: #f3f3f3;
    color: #333333;
    selection-background-color: #68217A;
    selection-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
}

QTextEdit#textEdit:focus {
    border: 1px solid #e0e0e0;
}

QTextEdit#numberLine {
    background-color: #e8e8e8;
    color: #666666;
    selection-background-color: transparent;
    border: 1px solid transparent;
    border-right: 1px solid #e0e0e0;
    border-radius: 8px;
}

QTextEdit#numberLine:focus {
    border: 1px solid transparent;
    border-right: 1px solid #e0e0e0;
}

QTextEdit#numberLine:disabled {
    background-color: #e8e8e8;
    color: #666666;
    selection-background-color: transparent;
}
QScrollBar:vertical {
    background-color: #f3f3f3;
    width: 16px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #c1c1c1;
    min-height: 20px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #a8a8a8;
}

QScrollBar::handle:vertical:pressed {
    background-color: #9e9e9e;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #f3f3f3;
    height: 16px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #c1c1c1;
    min-width: 20px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #a8a8a8;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #9e9e9e;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}
