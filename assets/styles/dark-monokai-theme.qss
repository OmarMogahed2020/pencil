/* Dark Monokai Theme for Pencil */

QMainWindow {
    background-color: #272822;
}

QMenuBar {
    background-color: #272822;
    color: #f8f8f2;
    border-bottom: 1px solid #3e3d32;
    padding: 2px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background-color: #3e3d32;
    color: #f8f8f2;
}

QMenuBar::item:pressed {
    background-color: #a6e22e;
    color: #272822;
}

QToolBar {
    background-color: #272822;
    border-bottom: 1px solid #3e3d32;
    spacing: 4px;
    padding: 4px;
}

QToolBar::separator {
    background-color: #3e3d32;
    width: 1px;
    height: 20px;
    margin: 4px 4px;
}

QToolBar::handle {
    background-color: transparent;
}

QToolBar QToolButton {
    background-color: transparent;
    border: none;
    color: #f8f8f2;
    padding: 4px 8px;
    border-radius: 3px;
    min-width: 24px;
}

QToolBar QToolButton:hover {
    background-color: #3e3d32;
    color: #f8f8f2;
}

QToolBar QToolButton:pressed {
    background-color: #a6e22e;
    color: #272822;
}

QToolBar QToolButton:checked {
    background-color: #a6e22e;
    color: #272822;
}

QMenu {
    background-color: #1e1f1c;
    color: #f8f8f2;
    border: 1px solid #3e3d32;
    padding: 4px;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 24px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #a6e22e;
    color: #272822;
}

QMenu::item:disabled {
    color: #808080;
}

QMenu::separator {
    background-color: #3e3d32;
    height: 1px;
    margin: 4px 8px;
}

QStatusBar {
    background-color: #75715e;
    color: #ffffff;
    border-top: none;
    padding: 4px;
}

QStatusBar::item {
    border: none;
}

/* ---- Buttons: modern glass ---- */
QPushButton,
QDialogButtonBox QPushButton,
QDialog QPushButton,
QFileDialog QPushButton,
QMessageBox QPushButton {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #ceef8c,
        stop: 0.55 #b8e858,
        stop: 1 #c9ed80
    );
    color: #16181d;
    border: 1px solid #c1eb6d;
    border-top: 1px solid #d2f096;
    border-radius: 10px;
    padding: 7px 22px;
    min-width: 88px;
    font-size: 10pt;
    font-weight: 600;
}

QPushButton:hover {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #ceef8c,
        stop: 0.55 #ceef8d,
        stop: 1 #d3f097
    );
    border: 1px solid #d2f096;
}

QPushButton:pressed {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #c1e47b,
        stop: 0.55 #b5d573,
        stop: 1 #b5d573
    );
    border: 1px solid #64881c;
    padding-top: 8px;
    padding-bottom: 6px;
}

QPushButton:focus {
    border: 1px solid #e4f6c0;
}

QPushButton:disabled {
    background-color: #3b4624;
    color: #202220;
    border: 1px solid #3b4624;
}

QPushButton::menu-indicator {
    width: 9px;
    height: 9px;
    subcontrol-position: center right;
    right: 10px;
}

QFileDialog {
    background-color: #1e1f1c;
    color: #f8f8f2;
}

QFileDialog QListView {
    background-color: #272822;
    color: #f8f8f2;
    border: 1px solid #3e3d32;
}

QFileDialog QTreeView {
    background-color: #272822;
    color: #f8f8f2;
    border: 1px solid #3e3d32;
}

QFileDialog QLineEdit {
    background-color: #3e3d32;
    color: #f8f8f2;
    border: 1px solid #75715e;
    padding: 4px;
    border-radius: 2px;
}

QMessageBox {
    background-color: #1e1f1c;
}

QMessageBox QLabel {
    color: #f8f8f2;
}

/* ---- Editor + gutter ---- */
QTextEdit#textEdit {
    background-color: #1e1f1c;
    color: #f8f8f2;
    selection-background-color: #49483e;
    selection-color: #f8f8f2;
    border: 1px solid #3e3d32;
    border-radius: 8px;
}

QTextEdit#textEdit:focus {
    border: 1px solid #3e3d32;
}

QTextEdit#numberLine {
    background-color: #33342c;
    color: #98988f;
    selection-background-color: transparent;
    border: 1px solid transparent;
    border-right: 1px solid #3e3d32;
    border-radius: 8px;
}

QTextEdit#numberLine:focus {
    border: 1px solid transparent;
    border-right: 1px solid #3e3d32;
}

QTextEdit#numberLine:disabled {
    background-color: #33342c;
    color: #8b8b83;
    selection-background-color: transparent;
}
QScrollBar:vertical {
    background-color: #1e1f1c;
    width: 16px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #75715e;
    min-height: 20px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #a6e22e;
}

QScrollBar::handle:vertical:pressed {
    background-color: #a6e22e;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #1e1f1c;
    height: 16px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #75715e;
    min-width: 20px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #a6e22e;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #a6e22e;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}
