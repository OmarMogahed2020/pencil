/* Light Github Theme for Pencil */

QMainWindow {
    background-color: #ffffff;
}

QMenuBar {
    background-color: #ffffff;
    color: #24292f;
    border-bottom: 1px solid #d0d7de;
    padding: 2px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background-color: #f6f8fa;
    color: #24292f;
}

QMenuBar::item:pressed {
    background-color: #0969da;
    color: #ffffff;
}

QToolBar {
    background-color: #ffffff;
    border-bottom: 1px solid #d0d7de;
    spacing: 4px;
    padding: 4px;
}

QToolBar::separator {
    background-color: #d0d7de;
    width: 1px;
    height: 20px;
    margin: 4px 4px;
}

QToolBar::handle {
    background-color: transparent;
}

QToolBar QToolButton {
    background-color: transparent;
    border: none;
    color: #24292f;
    padding: 4px 8px;
    border-radius: 3px;
    min-width: 24px;
}

QToolBar QToolButton:hover {
    background-color: #f6f8fa;
    color: #24292f;
}

QToolBar QToolButton:pressed {
    background-color: #0969da;
    color: #ffffff;
}

QToolBar QToolButton:checked {
    background-color: #0969da;
    color: #ffffff;
}

QMenu {
    background-color: #ffffff;
    color: #24292f;
    border: 1px solid #d0d7de;
    padding: 4px;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 24px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #0969da;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #808080;
}

QMenu::separator {
    background-color: #d0d7de;
    height: 1px;
    margin: 4px 8px;
}

QStatusBar {
    background-color: #0969da;
    color: #ffffff;
    border-top: none;
    padding: 4px;
}

QStatusBar::item {
    border: none;
}

/* ---- Buttons: modern glass ---- */
QPushButton,
QDialogButtonBox QPushButton,
QDialog QPushButton,
QFileDialog QPushButton,
QMessageBox QPushButton {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #1d75dd,
        stop: 0.55 #126edb,
        stop: 1 #0969da
    );
    color: #ffffff;
    border: 1px solid #064a99;
    border-top: 1px solid #84b4ec;
    border-radius: 10px;
    padding: 7px 22px;
    min-width: 88px;
    font-size: 10pt;
    font-weight: 600;
}

QPushButton:hover {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #1d75dd,
        stop: 0.55 #1470dc,
        stop: 1 #1d75dd
    );
    border: 1px solid #84b4ec;
}

QPushButton:pressed {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #085cc0,
        stop: 0.55 #064c9d,
        stop: 1 #064c9d
    );
    border: 1px solid #053f83;
    padding-top: 8px;
    padding-bottom: 6px;
}

QPushButton:focus {
    border: 1px solid #b5d2f4;
}

QPushButton:disabled {
    background-color: #d8e7f9;
    color: #ffffff;
    border: 1px solid #d8e7f9;
}

QPushButton::menu-indicator {
    width: 9px;
    height: 9px;
    subcontrol-position: center right;
    right: 10px;
}

QFileDialog {
    background-color: #ffffff;
    color: #24292f;
}

QFileDialog QListView {
    background-color: #ffffff;
    color: #24292f;
    border: 1px solid #d0d7de;
}

QFileDialog QTreeView {
    background-color: #ffffff;
    color: #24292f;
    border: 1px solid #d0d7de;
}

QFileDialog QLineEdit {
    background-color: #ffffff;
    color: #24292f;
    border: 1px solid #d0d7de;
    padding: 4px;
    border-radius: 2px;
}

QMessageBox {
    background-color: #ffffff;
}

QMessageBox QLabel {
    color: #24292f;
}

/* ---- Editor + gutter ---- */
QTextEdit#textEdit {
    background-color: #ffffff;
    color: #24292f;
    selection-background-color: #0969da;
    selection-color: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 8px;
}

QTextEdit#textEdit:focus {
    border: 1px solid #d0d7de;
}

QTextEdit#numberLine {
    background-color: #eaeef2;
    color: #6e7781;
    selection-background-color: transparent;
    border: 1px solid transparent;
    border-right: 1px solid #d0d7de;
    border-radius: 8px;
}

QTextEdit#numberLine:focus {
    border: 1px solid transparent;
    border-right: 1px solid #d0d7de;
}

QTextEdit#numberLine:disabled {
    background-color: #eaeef2;
    color: #6e7781;
    selection-background-color: transparent;
}
QScrollBar:vertical {
    background-color: #f6f8fa;
    width: 16px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #d0d7de;
    min-height: 20px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #0969da;
}

QScrollBar::handle:vertical:pressed {
    background-color: #0969da;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #f6f8fa;
    height: 16px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #d0d7de;
    min-width: 20px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #0969da;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #0969da;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}
