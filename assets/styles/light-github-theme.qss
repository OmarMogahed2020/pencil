/* Light Github Theme for Pencil */

QMainWindow {
    background-color: #ffffff;
}

QMenuBar {
    background-color: #ffffff;
    color: #24292f;
    border-bottom: 1px solid #d0d7de;
    padding: 2px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background-color: #f6f8fa;
    color: #24292f;
}

QMenuBar::item:pressed {
    background-color: #0969da;
    color: #ffffff;
}

QToolBar {
    background-color: #ffffff;
    border-bottom: 1px solid #d0d7de;
    spacing: 4px;
    padding: 4px;
}

QToolBar::separator {
    background-color: #d0d7de;
    width: 1px;
    height: 20px;
    margin: 4px 4px;
}

QToolBar::handle {
    background-color: transparent;
}

QToolBar QToolButton {
    background-color: transparent;
    border: none;
    color: #24292f;
    padding: 4px 8px;
    border-radius: 3px;
    min-width: 24px;
}

QToolBar QToolButton:hover {
    background-color: #f6f8fa;
    color: #24292f;
}

QToolBar QToolButton:pressed {
    background-color: #0969da;
    color: #ffffff;
}

QToolBar QToolButton:checked {
    background-color: #0969da;
    color: #ffffff;
}

QMenu {
    background-color: #ffffff;
    color: #24292f;
    border: 1px solid #d0d7de;
    padding: 4px;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 24px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #0969da;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #808080;
}

QMenu::separator {
    background-color: #d0d7de;
    height: 1px;
    margin: 4px 8px;
}

QStatusBar {
    background-color: #0969da;
    color: #ffffff;
    border-top: none;
    padding: 4px;
}

QStatusBar::item {
    border: none;
}

QFileDialog {
    background-color: #ffffff;
    color: #24292f;
}

QFileDialog QListView {
    background-color: #ffffff;
    color: #24292f;
    border: 1px solid #d0d7de;
}

QFileDialog QTreeView {
    background-color: #ffffff;
    color: #24292f;
    border: 1px solid #d0d7de;
}

QFileDialog QLineEdit {
    background-color: #ffffff;
    color: #24292f;
    border: 1px solid #d0d7de;
    padding: 4px;
    border-radius: 2px;
}

QFileDialog QPushButton {
    background-color: #0969da;
    color: #ffffff;
    border: none;
    padding: 6px 16px;
    border-radius: 2px;
}

QFileDialog QPushButton:hover {
    background-color: #f6f8fa;
}

QFileDialog QPushButton:pressed {
    background-color: #f6f8fa;
}

QMessageBox {
    background-color: #ffffff;
}

QMessageBox QLabel {
    color: #24292f;
}

QMessageBox QPushButton {
    background-color: #0969da;
    color: #ffffff;
    border: none;
    padding: 6px 16px;
    border-radius: 2px;
    min-width: 80px;
}

QMessageBox QPushButton:hover {
    background-color: #f6f8fa;
}

QScrollBar:vertical {
    background-color: #f6f8fa;
    width: 16px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #d0d7de;
    min-height: 20px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #0969da;
}

QScrollBar::handle:vertical:pressed {
    background-color: #0969da;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #f6f8fa;
    height: 16px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #d0d7de;
    min-width: 20px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #0969da;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #0969da;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}
